name: The History Uncut - Autonomous Daily Shorts Pipeline

on:
  schedule:
    # Slot 1: USA Morning Commute (06:15 AM EDT / 10:15 UTC / 04:15 PM BST)
    - cron: '15 10 * * *'
    # Slot 2: USA Midday Pre-Lunch & West Coast Morning (10:45 AM EDT / 14:45 UTC / 08:45 PM BST)
    - cron: '45 14 * * *'
    # Slot 3: USA Afternoon Drive & Office Exit (04:45 PM EDT / 20:45 UTC / 02:45 AM BST)
    - cron: '45 20 * * *'
    # Slot 4: USA National Evening Mega Prime Time (08:15 PM EDT / 00:15 UTC / 06:15 AM BST)
    - cron: '15 0 * * *'
  push:
    paths:
      - '.trigger_topic'
  workflow_dispatch:
    inputs:
      topic:
        description: 'Custom historical topic or era (optional)'
        required: false
        default: ''
      safety_buffer_hours:
        description: 'Copyright safety quarantine hours before going Public (default: 0 for instant live)'
        required: false
        default: '0'

jobs:
  generate-and-schedule:
    runs-on: ubuntu-latest
    permissions:
      contents: write

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up Node.js 18
        uses: actions/setup-node@v4
        with:
          node-version: 18
          cache: 'npm'

      - name: Set up Python 3.12 (For yt-dlp Cinematic Fetcher)
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Set up Deno (for yt-dlp JS challenge solver)
        uses: denoland/setup-deno@v1
        with:
          deno-version: v1.x

      - name: Install System Dependencies (FFmpeg & Fonts)
        run: |
          sudo apt-get update
          sudo apt-get install -y ffmpeg fonts-dejavu-core fonts-noto-color-emoji fonts-liberation fonts-freefont-ttf

      - name: Install Python CLI Tools (yt-dlp & edge-tts)
        run: |
          python -m pip install --upgrade pip
          pip install yt-dlp edge-tts

      - name: Install Node.js Dependencies
        run: |
          npm install --production=false

      - name: Generate Master Full-Bleed Short (Branding + Subscribe CTA + American Andrew Voice)
        env:
          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
          ELEVENLABS_API_KEY: ${{ secrets.ELEVENLABS_API_KEY }}
          ELEVENLABS_VOICE_ID: ${{ secrets.ELEVENLABS_VOICE_ID }}
          YTDLP_PATH: yt-dlp
          CUSTOM_TOPIC: ${{ github.event.inputs.topic }}
        run: |
          TARGET_TOPIC="$CUSTOM_TOPIC"
          if [ -z "$TARGET_TOPIC" ] && [ -f .trigger_topic ]; then
            TARGET_TOPIC=$(cat .trigger_topic | tr -d '\r\n')
            echo "Target topic loaded from .trigger_topic: $TARGET_TOPIC"
          fi

          if [ -n "$TARGET_TOPIC" ]; then
            echo "Generating full-bleed short with custom topic: $TARGET_TOPIC"
            node scripts/generate-fullbleed-documentary-short.js "$TARGET_TOPIC"
          else
            echo "Generating full-bleed short with autonomous AI historical outlier topic"
            node scripts/generate-fullbleed-documentary-short.js
          fi

      - name: Validate Video Integrity (Zero Black Screen Guarantee)
        run: |
          node scripts/verify-video-integrity.js

      - name: Upload to YouTube Studio with Scheduled Quarantine
        env:
          YOUTUBE_CLIENT_ID: ${{ secrets.YOUTUBE_CLIENT_ID }}
          YOUTUBE_CLIENT_SECRET: ${{ secrets.YOUTUBE_CLIENT_SECRET }}
          YOUTUBE_REFRESH_TOKEN: ${{ secrets.YOUTUBE_REFRESH_TOKEN }}
          SAFETY_HOURS: ${{ github.event.inputs.safety_buffer_hours || '0' }}
        run: |
          node scripts/upload-and-schedule-short.js "" "$SAFETY_HOURS"

      - name: Commit Upload History and State to Git
        # Always clean up the trigger file, even when generation fails —
        # otherwise a stale .trigger_topic traps every future run in the
        # same failing topic loop (incident 2026-10-06).
        if: always()
        run: |
          git config --global user.name "HistoryUncut Bot"
          git config --global user.email "bot@historyuncut.internal"
          rm -f .trigger_topic || true
          git add data/upload_history.log data/used_clips_history.json .trigger_topic || true
          git commit -m "Auto-update: Log published short & record used clips [skip ci]" || echo "No changes to commit"
          git push
